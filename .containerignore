# The build context is only used to create the toolchain image, which copies no
# project files — the source is bind-mounted at run time instead. Keeping the
# context near-empty makes `podman build` fast regardless of how large the
# working tree has grown.

# Build output. target/ in particular can be several GB.
target/
tmp/
vendor/

# VCS and planning artefacts: irrelevant to a toolchain image.
.git/
.gitignore
.github/
docs/
scripts/

# Editor and tooling state.
.vscode/
.idea/
.claude/
*.swp

# The build artefacts themselves.
*.rpm
